# Local macOS MariaDB can use the current account and /tmp/mysql.sock.
DB_NAME=gwero_crm
DB_USER=your-mysql-user
DB_PASSWORD=
DB_SOCKET=/tmp/mysql.sock
# For hosted MySQL, set DB_HOST and DB_PORT instead of DB_SOCKET.
# DB_HOST=127.0.0.1
# DB_PORT=3306
ATTACHMENT_DIR=var/attachments
CRON_SECRET=replace-with-a-long-random-value
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-value
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-app-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=your-microsoft-app-client-secret
